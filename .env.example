# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 커밋되지 않습니다)
#   cp .env.example .env

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=pawmesh
MYSQL_USER=pawmesh
MYSQL_PASSWORD=change-me-app-password

# 앱은 위 MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE 값을 그대로 사용해
# MySQL 컨테이너(DB_HOST=mysql)에 접속합니다. (docker-compose.yml 참고)

# --- Redis ---
# docker-compose 네트워크 내 서비스명/포트. 기본값(redis/6379)이면 비워둬도 됩니다.
# REDIS_HOST=redis
# REDIS_PORT=6379

# --- AWS S3 (이미지 저장소) ---
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=change-me-bucket
AWS_ACCESS_KEY_ID=change-me-access-key
AWS_SECRET_ACCESS_KEY=change-me-secret-key

# --- OpenAI (AI 펫 프로필 생성) ---
# gpt-image-1 사용에는 조직 인증된 키가 필요합니다. 절대 커밋하지 마세요.
OPEN_AI_API_KEY=sk-proj-change-me

# --- JWT ---
# 필수값. 미설정 시 앱이 기동되지 않습니다(fail-fast).
# HS256 서명을 위해 최소 32바이트(영문 기준 32자) 이상의 무작위 문자열로 설정하세요.
JWT_SECRET=change-me-please-use-a-long-random-secret-min-32-bytes
